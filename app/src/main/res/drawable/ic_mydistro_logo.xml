<!--
    MyDistro brand mark: two stacked forward chevrons suggesting goods moving
    along a route. Self-contained in brand orange so the same asset works on the
    navy hero screens and on white surfaces without a variant.

    Placeholder-quality but original — replace with the final licensed logo when
    brand assets are delivered. Nothing else needs to change: every screen
    renders it through MyDistroLogo().
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Leading chevron -->
    <path
        android:fillColor="#FF641F"
        android:pathData="M24,4 L40,20 L33,27 L24,18 L15,27 L8,20 Z" />

    <!-- Trailing chevron, lighter for depth -->
    <path
        android:fillColor="#FF8A52"
        android:pathData="M24,22 L40,38 L33,45 L24,36 L15,45 L8,38 Z" />
</vector>
